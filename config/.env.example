# TicketTrade — Environment Variable Template
#
# Copy to .env (gitignored) or export in your shell. These values are
# read by config/db.php and config/db.test.php.

# Database DSN — MySQL 8+ / MariaDB 10+ with utf8mb4 charset.
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=tickettrade;charset=utf8mb4

# Database user/password — defaults to root with no password in dev.
DB_USER=root
DB_PASS=

# Application environment — 'test' for PHPUnit (reads config/db.test.php).
APP_ENV=development
