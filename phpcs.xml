<?xml version="1.0"?>
<ruleset name="TicketTrade">
    <description>PSR-12 + project-specific overrides</description>
    <file>src/</file>
    <!-- Inherit PSR-12 (which includes PSR-1 / PSR-2). -->
    <rule ref="PSR12"/>
    <!-- Allow snake_case names in: error responses, model classes,
         the auth_service / user_service / points_service / listing_service /
         category_service class (per architecture spec). -->
    <exclude-pattern>src/Support/Error.php</exclude-pattern>
    <exclude-pattern>src/*/Model/*</exclude-pattern>
    <exclude-pattern>src/Auth/Service/auth_service.php</exclude-pattern>
    <exclude-pattern>src/User/Service/user_service.php</exclude-pattern>
    <exclude-pattern>src/Points/Service/points_service.php</exclude-pattern>
    <exclude-pattern>src/Listing/Service/listing_service.php</exclude-pattern>
<exclude-pattern>src/Ticket/Service/ticket_service.php</exclude-pattern>
<exclude-pattern>src/Ticket/Model/ticket_model.php</exclude-pattern>
    <exclude-pattern>src/Category/Service/category_service.php</exclude-pattern>
    <!-- Allow long lines in templates (line breaks would break the render). -->
    <rule ref="Generic.Files.LineLength">
        <severity>0</severity>
    </rule>
</ruleset>
