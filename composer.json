{
    "name": "nsbm/tickettrade",
    "type": "project",
    "description": "NSBM Green University campus-only peer-to-peer marketplace",
    "require": {
        "php": ">=8.3",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
